# DeepSeek Client release settings for Windows. Copy to .env.windows (Git ignored) before packaging:
#   copy apps\desktop\.env.windows.client apps\desktop\.env.windows
#   pnpm --filter @deepseek-ai/dsh-desktop exec tsx scripts/package-target.ts win-x64 --unsigned
#
# This build is not published through DeepSeek's update service, so it ships without one:
#  - unsigned packaging embeds no auto-update feed;
#  - DSH_DESKTOP_MANDATORY_UPDATE=off embeds no mandatory-update policy, so the app never polls a
#    policy server that could force-replace it with the official build.
DSH_DESKTOP_APP_ID=com.gorxe111.deepseek-client
DSH_DESKTOP_MANDATORY_UPDATE=off

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
